SLUGSEAT_DATABASE_URL=sqlite:///./slugseat.db
SLUGSEAT_DEFAULT_TERM=2270
SLUGSEAT_MIN_REQUEST_INTERVAL=2.0
SLUGSEAT_CACHE_TTL_SECONDS=60
SLUGSEAT_POLL_INTERVAL_SECONDS=60

SLUGSEAT_NOTIFIER=email
