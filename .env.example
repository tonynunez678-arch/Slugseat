SLUGSEAT_SMTP_USER=yourname@gmail.com
SLUGSEAT_SMTP_PASSWORD=your16letterapppassword

SLUGSEAT_API_BASE_URL=http://localhost:8000
SLUGSEAT_FRONTEND_URL=http://localhost:5173

SLUGSEAT_TWILIO_ACCOUNT_SID=
